# MongoDB Connection URI (e.g. MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/food-del?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Stripe Payment Secret Key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Server Port (Render / Railway assign PORT automatically, default: 4000)
PORT=4000

# Frontend URL (For CORS and Stripe redirect URLs)
FRONTEND_URL=https://your-frontend-app.vercel.app
